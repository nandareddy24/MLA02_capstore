# FixWise Backend Environment Configuration Template
# Copy this file to `.env` for local development and NEVER commit `.env` with real secrets.

# Environment: development | staging | production
FIXWISE_ENV=development

# MySQL 8 SQLAlchemy connection string (recommended for multi-user deployment):
# mysql+pymysql://<db_user>:<db_password>@<db_host>:3306/<db_name>?charset=utf8mb4
FIXWISE_DATABASE_URL=mysql+pymysql://fixwise_user:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:3306/fixwise?charset=utf8mb4

# Cryptographically random >=32-character secret for signing JWT tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FIXWISE_JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET_AT_LEAST_32_CHARS

# Token lifetimes
FIXWISE_ACCESS_TOKEN_MINUTES=60
FIXWISE_REFRESH_TOKEN_DAYS=14

# Comma-separated list of explicitly allowed CORS origins (never use * in production)
FIXWISE_CORS_ORIGINS=https://app.fixwise.example.com

# Enforce HTTPS redirection & HSTS headers in production
FIXWISE_ENFORCE_HTTPS=false

# Per-IP rate limiting
FIXWISE_RATE_LIMIT_REQUESTS=120
FIXWISE_RATE_LIMIT_WINDOW_SECONDS=60
